# Copy thành .env:  cp .env.example .env   (Windows: copy .env.example .env)
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=fashion
MYSQL_USER=fashion
MYSQL_PASSWORD=fashion_change_me
MYSQL_PORT=3306

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# JWT secret phải dài >= 32 ký tự
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Chỉ dùng khi chạy: docker compose --profile full up --build
NEXT_PUBLIC_API_URL=http://localhost:8080
